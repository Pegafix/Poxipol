# Copia a .env y ajusta. Todo se valida al arrancar (src/config.ts).
PORT=8080
DATABASE_URL=postgres://postgres@localhost:5432/mochi
REDIS_URL=redis://localhost:6379
# Mínimo 32 caracteres. Firma los tokens de acceso (HS256).
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-123456
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=60
# Corta consultas lentas para que ningún cliente quede colgado.
DB_STATEMENT_TIMEOUT_MS=4000
RUN_IMPORT_WORKER=true
