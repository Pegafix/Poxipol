{
  "name": "mochi-api",
  "version": "0.1.0",
  "private": true,
  "description": "API multiplataforma de Mochi Roadmap: estado del compañero, árbol de habilidades, crafteo y misiones desde PDF.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "fastify": "5.2.1",
    "ioredis": "5.4.1",
    "jose": "5.9.6",
    "pdfjs-dist": "^3.11.174",
    "pg": "8.13.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "@types/pg": "8.11.10",
    "tsx": "4.19.2",
    "typescript": "5.6.3"
  }
}
